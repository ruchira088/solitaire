{
  "name": "cdk-deploy",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "cdk-deploy": "bin/cdk-deploy.js"
  },
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "cdk-deploy": "cdk deploy --require-approval=never",
    "deploy": "npm run build && npm run cdk-deploy",
    "destroy": "npm run build && cdk destroy --all --force"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk": "^2.1138.0",
    "react-app-cdk-deploy": "github:ruchira088/react-app-cdk-deploy#v1.1.3"
  },
  "allowScripts": {
    "github:ruchira088/react-app-cdk-deploy#03b8e278b72e9ea350eace0e17633dfb9a83b2f2": true
  }
}
