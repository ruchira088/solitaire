{
  "name": "cdk-deploy",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "cdk-deploy": "bin/cdk-deploy.js"
  },
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "cdk-deploy": "cdk deploy --require-approval=never",
    "deploy": "npm run build && npm run cdk-deploy",
    "destroy": "npm run build && cdk destroy --all --force"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk": "^2.1141.0",
    "react-app-cdk-deploy": "github:ruchira088/react-app-cdk-deploy#v1"
  },
  "allowScripts": {
    "github:ruchira088/react-app-cdk-deploy#2b945c4f1d766168c10970fec22a8e05b4d9494c": true
  }
}
