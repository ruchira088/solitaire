{
  "name": "solitaire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A high-quality Klondike Solitaire clone (TypeScript + Canvas)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && node scripts/check-docs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "size": "node scripts/check-size.mjs",
    "screenshots": "node scripts/shoot-screenshots.mjs",
    "cards:rasterize": "node scripts/rasterize-cards.mjs",
    "cards:optimize": "svgo -f public/cards --config svgo.config.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
